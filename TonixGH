-- =============================================
-- DETECCIÓN DE ROL
-- =============================================
local function getRole(player)
    local character = player.Character
    if not character then return "Civil" end
    
    -- Buscar etiqueta de rol
    local roleTag = character:FindFirstChild("Role") 
        or character:FindFirstChild("role") 
        or character:FindFirstChild("Team")
    if roleTag then
        return tostring(roleTag.Value or roleTag.Name)
    end
    
    -- Buscar por TeamColor
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.TeamColor then
        local colorName = humanoid.TeamColor.Name:lower()
        if colorName:find("red") or colorName:find("assassin") or colorName:find("criminal") then
            return "Asesino"
        elseif colorName:find("blue") or colorName:find("sheriff") or colorName:find("police") then
            return "Sheriff"
        end
    end
    return "Civil"
end

local function isAssassin(player)
    local role = getRole(player)
    return role == "Asesino" 
        or role:lower():find("assassin") ~= nil
        or role:lower():find("red") ~= nil
end

local function isSheriff(player)
    local role = getRole(player)
    return role == "Sheriff" 
        or role:lower():find("sheriff") ~= nil
        or role:lower():find("blue") ~= nil
end

