-- ESP
local espObjects = {}
local function createESP(player)
    if not player or player == LocalPlayer then return end
    local esp = Drawing.new("Text")
    esp.Size = 14
    esp.Center = true
    esp.Outline = true
    esp.OutlineColor = Color3.new(0, 0, 0)
    esp.Visible = false
    espObjects[player] = esp
end

local function updateESP()
    for player, esp in pairs(espObjects) do
        if Settings.ESP and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local rootPart = player.Character.HumanoidRootPart
            local screenPos, onScreen = Camera:WorldToScreenPoint(rootPart.Position)
            if onScreen then
                esp.Position = Vector2.new(screenPos.X, screenPos.Y - 100)
                if isAssassin(player) then
                    esp.Color = Color3.new(1, 0, 0)
                    esp.Text = player.Name .. " [ASSASSIN]"
                elseif isSheriff(player) then
                    esp.Color = Color3.new(0, 0, 1)
                    esp.Text = player.Name .. " [SHERIFF]"
                else
                    esp.Color = Color3.new(1, 1, 1)
                    esp.Text = player.Name
                end
                esp.Visible = true
            else
                esp.Visible = false
            end
        else
            esp.Visible = false
        end
    end
end

-- DISPARO AUTOMÁTICO (Sheriff)
local function findVisibleAssassin()
    local cameraPos = Camera.CFrame.Position
    local cameraDirection = Camera.CFrame.LookVector
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if isAssassin(player) then
                local rootPart = player.Character.HumanoidRootPart
                local screenPos, onScreen = Camera:WorldToScreenPoint(rootPart.Position)
                if onScreen then
                    local distance = (rootPart.Position - cameraPos).Magnitude
                    if distance < 200 then
                        return player, rootPart
                    end
                end
            end
        end
    end
    return nil, nil
end

local function autoShoot()
    if not Settings.AutoShoot then return end
    if not isSheriff(LocalPlayer) then return end
    
    local target, rootPart = findVisibleAssassin()
    if target and rootPart then
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, rootPart.Position)
        
        local character = LocalPlayer.Character
        if character then
            for _, tool in pairs(character:GetChildren()) do
                if tool:IsA("Tool") then
                    tool:Activate()
                end
            end
        end
    end
end

-- KILL ALL (Asesino)
local function killAll()
    if not Settings.KillAll then return end
    if not isAssassin(LocalPlayer) then return end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") then
            local humanoid = player.Character.Humanoid
            humanoid.Health = 0
        end
    end
end

-- CUCHILLO AUTOMÁTICO (Asesino)
local function autoKnife()
    if not Settings.AutoKnife then return end
    if not isAssassin(LocalPlayer) then return end
    
    local character = LocalPlayer.Character
    if character then
        local knife = character:FindFirstChild("Knife") or character:FindFirstChild("knife")
        
        local closest = nil
        local closestDist = 100
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (player.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = player
                    end
                end
            end
        end
        
        if closest and closest.Character then
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.lookAt(hrp.Position, closest.Character.HumanoidRootPart.Position)
                
                if knife then
                    knife:Activate()
                end
            end
        end
    end
end

